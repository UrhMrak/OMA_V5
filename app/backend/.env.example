# Backend environment variables (copy to .env for local dev, set in Render for prod)

# Port the server listens on (Render sets this automatically)
PORT=4000

# Comma-separated list of allowed frontend origins (CORS).
# Local dev + your GitHub Pages URL, e.g.:
# FRONTEND_ORIGIN=http://localhost:5173,https://YOUR_GITHUB_USERNAME.github.io
FRONTEND_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Login passwords for the two demo accounts.
ADMIN_PASSWORD=admin123
MUSICIAN_PASSWORD=musician123

# Supabase project credentials (Project Settings -> API).
# Use the SERVICE ROLE key here. It must NEVER be exposed to the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket names (defaults match supabase/schema.sql)
SUPABASE_LIBRARY_BUCKET=library
SUPABASE_POSTS_BUCKET=posts
